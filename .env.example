# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/square_cube?schema=public"

# ── JWT & Cookies ─────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-32-char-random-string"
COOKIE_SECRET="replace-with-32-char-random-string"
JWT_EXPIRES_IN="7d"

# ── Admin Credentials ─────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@squarecube.in"
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH"

# ── Cloudinary (free tier — image uploads) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="square-cube-furniture"

# ── Google Gemini AI (FREE tier — AI Room Stylist) ───────────────────────────
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# No "+" prefix. Country code + number. Default: 918547097173
NEXT_PUBLIC_WHATSAPP_NUMBER="918547097173"
ADMIN_WA_NUMBER="918547097173"

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"
